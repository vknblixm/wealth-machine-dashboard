# ═══ STRIPE (Required for real payments) ═══
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# ═══ EMAIL (Required for lead capture + fulfillment) ═══
# Get from https://resend.com (free tier = 100 emails/day)
RESEND_API_KEY=re_YOUR_KEY_HERE
FROM_EMAIL=Wealth Machine <hello@yourdomain.com>

# ═══ MAILCHIMP (Optional — for email list) ═══
MAILCHIMP_API_KEY=YOUR_MAILCHIMP_KEY
MAILCHIMP_LIST_ID=YOUR_LIST_ID

# ═══ DISCORD (Optional — for notifications) ═══
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK

# ═══ APP CONFIG ═══
NEXT_PUBLIC_APP_URL=http://localhost:4200
NEXT_PUBLIC_API_URL=http://localhost:4200
